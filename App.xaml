<Application x:Class="CombatLogViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1E1F24"/>
        <SolidColorBrush x:Key="Card" Color="#2A2C33"/>
        <SolidColorBrush x:Key="CardBest" Color="#35392A"/>
        <SolidColorBrush x:Key="Panel" Color="#24262C"/>
        <SolidColorBrush x:Key="Fg" Color="#E8E8EA"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9CA5"/>
        <SolidColorBrush x:Key="Accent" Color="#F2C94C"/>
        <SolidColorBrush x:Key="Line" Color="#3A3D46"/>

        <!-- Keyed, not implicit: an app-wide implicit TextBlock style would also recolor the text inside
             ComboBoxes and Buttons. MainWindow applies DefaultText as its implicit style. -->
        <Style x:Key="DefaultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource DefaultText}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource DefaultText}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
    </Application.Resources>
</Application>
