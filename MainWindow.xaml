<Window x:Class="CombatLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CombatLogViewer"
        Title="Combat Log Viewer" Width="1280" Height="860" MinWidth="900" MinHeight="500"
        Background="{StaticResource Bg}" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <!-- Card templates are kept shallow (one TextBlock per stat list, no nested lists or TextBoxes)
         because each card is built while scrolling; that is what keeps fast scrolling smooth. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}"/>

        <!-- Grip shown on every run: the whole card drags its Battle folder (see RunList_PreviewMouseMove) -->
        <Style x:Key="Grip" TargetType="TextBlock" BasedOn="{StaticResource DefaultText}">
            <Setter Property="Text" Value="⠿"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="ToolTip" Value="Drag this run onto a web page or folder to share its Battle folder"/>
        </Style>

        <!-- ▶ button on runs that have a recording; opens it in the default video player -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Open the recording"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource Panel}" CornerRadius="5" Padding="9,3">
                            <TextBlock Text="▶ Video" Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Line}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A fixed teammate/set slot; hidden when the run has fewer teammates or sets -->
        <Style x:Key="Slot" TargetType="ContentPresenter">
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One Drive Disc set -->
        <DataTemplate x:Key="SetTemplate" DataType="{x:Type local:SetVM}">
            <DockPanel Margin="0,2,0,2" Background="Transparent" ToolTip="{Binding ToolTip}">
                <Image Source="{Binding Set.Icon}" Width="30" Height="30" VerticalAlignment="Top"/>
                <TextBlock Margin="8,0,0,0" TextWrapping="Wrap" FontSize="12.5">
                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Set.Title, Mode=OneWay, TargetNullValue='Drive Disc set'}"/>
                    <LineBreak/>
                    <Run Text="{Binding Set.Bonus2, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Muted}"/>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <!-- One teammate: agent, W-Engine, Drive Disc sets, main stats and substat rolls -->
        <DataTemplate x:Key="MemberTemplate" DataType="{x:Type local:MemberVM}">
            <StackPanel Margin="0,0,18,0">
                <DockPanel>
                    <Border Width="64" Height="64" CornerRadius="6" Background="{StaticResource Panel}" ClipToBounds="True">
                        <Image Source="{Binding Agent.Icon}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Margin="10,2,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                        <LineBreak/>
                        <Run Text="{Binding Info, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </TextBlock>
                </DockPanel>

                <DockPanel Margin="0,8,0,0">
                    <Image Source="{Binding WEngine.Icon}" Width="34" Height="34" VerticalAlignment="Top"/>
                    <TextBlock Margin="8,0,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding WEngine.Title, Mode=OneWay, TargetNullValue='W-Engine', FallbackValue='No W-Engine'}" FontSize="12.5"/>
                        <LineBreak/>
                        <Run Text="{Binding WEngineInfo, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </TextBlock>
                </DockPanel>

                <TextBlock Text="DRIVE DISC SETS" Style="{StaticResource SectionText}"
                           Visibility="{Binding HasSets, Converter={StaticResource Vis}}"/>
                <ContentPresenter Style="{StaticResource Slot}" Content="{Binding Set1}" ContentTemplate="{StaticResource SetTemplate}"/>
                <ContentPresenter Style="{StaticResource Slot}" Content="{Binding Set2}" ContentTemplate="{StaticResource SetTemplate}"/>
                <ContentPresenter Style="{StaticResource Slot}" Content="{Binding Set3}" ContentTemplate="{StaticResource SetTemplate}"/>

                <TextBlock Text="MAIN STATS" Style="{StaticResource SectionText}"
                           Visibility="{Binding HasMainStats, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding MainStats}" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18"
                           Visibility="{Binding HasMainStats, Converter={StaticResource Vis}}"/>

                <TextBlock Text="SUBSTATS" Style="{StaticResource SectionText}"
                           Visibility="{Binding HasSubstats, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding Substats}" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18"
                           Visibility="{Binding HasSubstats, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- One run, full detail -->
        <DataTemplate x:Key="BattleTemplate" DataType="{x:Type local:BattleVM}">
            <Border x:Name="CardBorder" TextElement.Foreground="{StaticResource Fg}" Background="{StaticResource Card}" CornerRadius="8" Padding="18,12,18,16" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Margin="18,0,0,0" TextAlignment="Right">
                                <Run Text="Score" FontSize="12" Foreground="{StaticResource Muted}"/>
                                <LineBreak/>
                                <Run Text="{Binding Score, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            </TextBlock>
                            <TextBlock Margin="24,0,0,0" TextAlignment="Right">
                                <Run Text="Total damage" FontSize="12" Foreground="{StaticResource Muted}"/>
                                <LineBreak/>
                                <Run Text="{Binding Damage, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Margin="24,0,0,0" TextAlignment="Right">
                                <Run Text="Duration" FontSize="12" Foreground="{StaticResource Muted}"/>
                                <LineBreak/>
                                <Run Text="{Binding Duration, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Grip}" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource PlayButton}" DockPanel.Dock="Right" Margin="0,0,6,0" Click="Recording_Click"
                                Visibility="{Binding HasRecording, Converter={StaticResource Vis}}"/>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                            <Run Text="{Binding StartTime, Mode=OneWay}" FontSize="13" Foreground="{StaticResource Muted}"/>
                            <LineBreak/>
                            <Run Text="{Binding Team, Mode=OneWay}" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </TextBlock>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,12"/>
                    <UniformGrid Rows="1" Columns="3">
                        <ContentPresenter Style="{StaticResource Slot}" Content="{Binding M1}" ContentTemplate="{StaticResource MemberTemplate}"/>
                        <ContentPresenter Style="{StaticResource Slot}" Content="{Binding M2}" ContentTemplate="{StaticResource MemberTemplate}"/>
                        <ContentPresenter Style="{StaticResource Slot}" Content="{Binding M3}" ContentTemplate="{StaticResource MemberTemplate}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource CardBest}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One teammate in the minimal row: icon, then investment and name ("61 Phoenix") -->
        <DataTemplate x:Key="MiniAgentTemplate" DataType="{x:Type local:MemberVM}">
            <DockPanel Margin="0,0,16,0">
                <Border Width="44" Height="44" CornerRadius="5" ClipToBounds="True" Background="{StaticResource Panel}">
                    <Image Source="{Binding Agent.Icon}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="15">
                    <Run Text="{Binding Investment, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <!-- One run, minimal: battle, score and the team -->
        <DataTemplate x:Key="MinimalTemplate" DataType="{x:Type local:BattleVM}">
            <Border x:Name="RowBorder" TextElement.Foreground="{StaticResource Fg}" Background="{StaticResource Card}" CornerRadius="6" Padding="14,6" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Grip}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                        <Run Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="Bold"/>
                        <Run Text="{Binding StartTime, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource PlayButton}" HorizontalAlignment="Left" Click="Recording_Click"
                            Visibility="{Binding HasRecording, Converter={StaticResource Vis}}"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,32,0">
                        <Run Text="Score" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <Run Text="{Binding Score, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <UniformGrid Grid.Column="3" Rows="1" Columns="3">
                        <ContentPresenter Style="{StaticResource Slot}" Content="{Binding M1}" ContentTemplate="{StaticResource MiniAgentTemplate}"/>
                        <ContentPresenter Style="{StaticResource Slot}" Content="{Binding M2}" ContentTemplate="{StaticResource MiniAgentTemplate}"/>
                        <ContentPresenter Style="{StaticResource Slot}" Content="{Binding M3}" ContentTemplate="{StaticResource MiniAgentTemplate}"/>
                    </UniformGrid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource CardBest}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="230" Background="{StaticResource Panel}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="OBS recording" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="ObsStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <Button x:Name="StartObsButton" Content="Start OBS (hidden in tray)" Click="StartObs_Click" Padding="10,5" Margin="0,0,0,6"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="ObsMessageText" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button Content="OBS settings…" Click="ObsSettings_Click" Padding="10,5" Margin="0,0,0,16"/>
                    <Button Content="Refresh" Click="Refresh_Click" Padding="10,5" Margin="0,0,0,6"/>
                    <Button Content="Change logs folder…" Click="ChangeFolder_Click" Padding="10,5"/>
                    <TextBlock x:Name="FolderText" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Search" FontWeight="SemiBold" FontSize="14"/>
                    <Grid Margin="0,4,0,14">
                        <TextBox x:Name="SearchBox" FontSize="14" Padding="4,3" TextChanged="Search_Changed" KeyDown="Search_KeyDown"
                                 ToolTip="Battle number or agent names, e.g. &quot;15&quot;, &quot;1 (2)&quot;, &quot;yanagi&quot;, &quot;phoenix yuzuha&quot;. Searches every day. Esc clears."/>
                        <TextBlock Text="Battle # or agent…" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Day" FontWeight="SemiBold" FontSize="14"/>
                    <ComboBox x:Name="DayBox" Margin="0,4,0,14" FontSize="14" SelectionChanged="Day_Changed"/>
                    <TextBlock Text="Sort runs by" FontWeight="SemiBold" FontSize="14"/>
                    <ComboBox x:Name="SortBox" Margin="0,4,0,14" FontSize="13" SelectedIndex="0" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Most recent first"/>
                        <ComboBoxItem Content="Battle number"/>
                        <ComboBoxItem Content="Score"/>
                        <ComboBoxItem Content="Total damage"/>
                    </ComboBox>
                    <CheckBox x:Name="MinimalBox" Content="Minimal view" Foreground="{StaticResource Fg}" FontSize="13"
                              Margin="0,0,0,14" Checked="Minimal_Changed" Unchecked="Minimal_Changed"/>
                    <TextBlock Text="Show only" FontWeight="SemiBold" FontSize="14"/>
                    <CheckBox x:Name="DummyBox" Content="Dummy runs" Foreground="{StaticResource Fg}" FontSize="13" Margin="0,4,0,4"
                              Checked="Filter_Changed" Unchecked="Filter_Changed"
                              ToolTip="Runs against the training dummy (about 3.3 billion HP)"/>
                    <CheckBox x:Name="CompleteBox" Content="Completed runs" Foreground="{StaticResource Fg}" FontSize="13" Margin="0,0,0,14"
                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Runs of the selected day. CacheLength keeps a page of cards built above and below the
             view, so they are ready before they scroll in. -->
        <Grid>
            <ListBox x:Name="RunList" ItemTemplate="{StaticResource BattleTemplate}" Background="Transparent" BorderThickness="0"
                     Padding="12,12,4,2" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page"
                     MouseRightButtonUp="RunList_RightClick"
                     PreviewMouseLeftButtonDown="RunList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="RunList_PreviewMouseMove">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="0,0,8,0"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
